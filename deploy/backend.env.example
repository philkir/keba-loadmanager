# Betriebsmodus: active regelt echte KEBA-Geräte; commissioning ist der Nur-Lese-Modus.
MODE=active
API_TOKEN=BITTE_MIT_DEPLOY_INIT_CONFIG_ERZEUGEN
CONTROLLER_TOKEN=BITTE_MIT_DEPLOY_INIT_CONFIG_ERZEUGEN
CONTROLLER_URL=http://127.0.0.1:8091
DB_PATH=/var/lib/keba/loadmanager.sqlite
STATIONS_CONFIG_PATH=/etc/keba/stations.json
# Nur erforderlich, wenn die Container-Oberfläche direkt über einen Tunnel veröffentlicht wird.
WEB_ALLOWED_ORIGINS=
