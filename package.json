{
  "name": "keba-loadmanager", "version": "0.2.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1", "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit", "cf:types": "wrangler types",
    "cf:dev": "wrangler dev --ip 127.0.0.1", "cf:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy", "test": "vitest run"
  },
  "dependencies": {"react": "^19.1.0", "react-dom": "^19.1.0", "lucide-react": "^0.468.0", "jose": "^6.0.0"},
  "devDependencies": {"typescript": "^5.9.0", "vite": "^7.1.0", "@vitejs/plugin-react": "^5.0.0", "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@types/node": "^24.0.0", "wrangler": "^4.0.0", "vitest": "^3.2.0", "@playwright/test": "^1.55.0"}
}
